---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { sortedPosts, postPath, yearMonthDay } from '../lib/posts';

const posts = await sortedPosts();
const [aboutEntry] = await getCollection('pages');
const { Content: About } = aboutEntry ? await render(aboutEntry) : { Content: null };
---

<Base>
  <h1 class="visually-hidden">yui's blog</h1>
  <section class="masthead prose">
    {About && <About />}
  </section>

  <ul class="post-list">
    {
      posts.map((post, i) => (
        <li class="post-item" style={`--i: ${i}`}>
          <a class="post-link plain" href={postPath(post)}>
            <span class="post-title" lang={post.data.lang ?? 'zh-Hant'}>{post.data.title}</span>
            <span class="post-date">{yearMonthDay(post.data.date)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<script>
  // "beat" 链接尾部注入 4×4 MPC 打击垫;每个 pad 随机相位,像手指打拍子
  const beatLink = document.querySelector('.masthead a[href*="soundcloud"]');
  if (beatLink) {
    const grid = document.createElement('span');
    grid.className = 'mpc';
    grid.setAttribute('aria-hidden', 'true');
    for (let i = 0; i < 16; i++) {
      const pad = document.createElement('span');
      pad.className = 'mpc-pad';
      pad.style.animationDelay = `${(Math.random() * 1.5).toFixed(2)}s`;
      pad.style.animationDuration = `${(1.1 + Math.random() * 0.9).toFixed(2)}s`;
      grid.appendChild(pad);
    }
    beatLink.appendChild(grid);
  }

  // "Tokyo" 内注入东京铁塔剪影,塔尖航空灯明灭
  const tokyo = document.querySelector('.masthead .tokyo');
  if (tokyo) {
    tokyo.insertAdjacentHTML(
      'beforeend',
      '<svg class="tt" viewBox="0 0 20 26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle class="tt-beacon" cx="10" cy="2" r="1.3" fill="currentColor" stroke="none"/><path d="M10 4.5 V7"/><path d="M10 7 Q9.2 18 3.5 25"/><path d="M10 7 Q10.8 18 16.5 25"/><path d="M6.9 16.5 H13.1"/><path d="M4.9 21.5 H15.1"/></svg>'
    );
  }
</script>

<style>
  .masthead {
    margin-block-end: var(--space-2xl);
  }

  .masthead :global(h2:first-child) {
    margin-block-start: 0;
  }

  /* "beat" hover:字样隐去,原位显示 4×4 MPC 打击垫,pad 随机被敲下 */
  .masthead :global(a[href*='soundcloud']) {
    position: relative;
    text-decoration: none;
    transition: color 0.18s ease-out;
  }

  /* 交换仅在指针 hover 时发生:键盘聚焦保留 "beat" 字样与焦点框 */
  .masthead :global(a[href*='soundcloud']:hover) {
    color: transparent;
  }

  .masthead :global(.mpc) {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    grid-template-columns: repeat(4, 4px);
    gap: 2px;
    opacity: 0;
    transition: opacity 0.18s ease-out;
    pointer-events: none;
    color: var(--accent);
  }

  .masthead :global(.mpc-pad) {
    width: 4px;
    height: 4px;
    border-radius: 1px;
    background: currentColor;
    opacity: 0.3;
    animation: pad-press 1.5s ease-out infinite;
    animation-play-state: paused;
  }

  .masthead :global(a[href*='soundcloud']:hover .mpc) {
    opacity: 1;
  }

  .masthead :global(a[href*='soundcloud']:hover .mpc-pad) {
    animation-play-state: running;
  }

  @keyframes pad-press {
    0%,
    14%,
    100% {
      opacity: 0.3;
      transform: none;
    }
    5% {
      opacity: 1;
      transform: scale(0.65);
    }
  }

  /* "Tokyo" hover:字样隐去,原位显示东京铁塔,塔尖航空灯明灭 */
  .masthead :global(.tokyo) {
    position: relative;
    cursor: default;
    transition: color 0.18s ease-out;
  }

  .masthead :global(.tokyo:hover) {
    color: transparent;
  }

  .masthead :global(.tt) {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 18px;
    height: 23px;
    opacity: 0;
    transition: opacity 0.18s ease-out;
    pointer-events: none;
    color: var(--accent);
  }

  .masthead :global(.tokyo:hover .tt) {
    opacity: 1;
  }

  .masthead :global(.tt-beacon) {
    animation: beacon 1.6s ease-in-out infinite;
    animation-play-state: paused;
  }

  .masthead :global(.tokyo:hover .tt-beacon) {
    animation-play-state: running;
  }

  @keyframes beacon {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.15;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead :global(.mpc-pad),
    .masthead :global(.tt-beacon) {
      animation: none;
    }
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-item + .post-item {
    border-top: 1px solid var(--rule);
  }

  .post-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: 0.9rem;
  }

  .post-title {
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.6;
    transition: color 0.18s ease-out;
  }

  .post-link:hover .post-title {
    color: var(--accent);
  }

  .post-date {
    font-size: var(--text-meta);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* 列表入场:每项 30ms 递进 */
  @media (prefers-reduced-motion: no-preference) {
    .post-item {
      animation: item-enter 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(var(--i) * 30ms);
    }

    @keyframes item-enter {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
    }
  }

  @media (max-width: 40rem) {
    .masthead {
      margin-block-end: var(--space-xl);
    }

    .post-link {
      flex-direction: column;
      gap: 0.1rem;
      align-items: flex-start;
    }
  }
</style>
